# Template for .env / .env.local / .env.production. Copy the parts you need; never commit real secrets.

# --- Backend location -------------------------------------------------------------------------
# Local dev (npm run dev): leave VITE_BACKEND_URL empty. The browser calls the Vite dev server
# (same origin) and Vite proxies /auth, /users, /ws-chat, ... to DEV_PROXY_TARGET.
#
#   Test against your local backend:   (set nothing)            -> http://localhost:8080
#   Test against the Oracle backend:   DEV_PROXY_TARGET=https://<your-subdomain>.duckdns.org
#
# Production build (npm run build / Vercel): set VITE_BACKEND_URL (in Vercel > Settings >
# Environment Variables, or .env.production) so the deployed frontend calls the Oracle backend
# directly. The deployed site's origin must be in the backend's CORS_ALLOWED_ORIGINS.
#
#   VITE_BACKEND_URL=https://<your-subdomain>.duckdns.org
VITE_BACKEND_URL=
DEV_PROXY_TARGET=

# --- Firebase (web config, public) ------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Browser push (FCM): Firebase console > Project settings > Cloud Messaging > Web Push certificates
# > "Key pair". Without it push stays off and the in-app notifications still work.
VITE_FIREBASE_VAPID_KEY=

# --- Cloudinary (unsigned upload preset) ------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_PRESET=

# --- Maps -------------------------------------------------------------------------------------
VITE_CARTO_API_KEY=

# Production address (canonical URLs, share image, sitemap)
VITE_SITE_URL=https://www.randomchatly.com
